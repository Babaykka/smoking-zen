{
  "name": "smoking-zen",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:production": "playwright test --config=playwright.production.config.ts",
    "test:scripts": "bats tests/scripts/*.bats",
    "lint:shell": "shellcheck scripts/*.sh tests/scripts/test_helper.bash tests/scripts/*.bats",
    "staging:preflight": "node scripts/staging-preflight.mjs",
    "staging:migrate": "scripts/apply-staging-migrations.sh",
    "staging:evidence": "node scripts/validate-staging-evidence.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "fast-xml-parser": "5.10.1",
    "file-type": "^22.0.1",
    "jose": "^6.2.6",
    "lucide-react": "^0.468.0",
    "next": "^16.0.7",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.2.108",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "yauzl": "^3.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@electric-sql/pglite": "^0.5.4",
    "@playwright/test": "^1.50.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/yauzl": "^3.4.0",
    "ajv": "8.20.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.0.7",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^7.0.0",
    "vitest": "^4.0.18"
  },
  "packageManager": "pnpm@10.14.0",
  "pnpm": {
    "overrides": {
      "next>postcss": "8.5.26",
      "next>sharp": "0.35.3"
    }
  }
}
