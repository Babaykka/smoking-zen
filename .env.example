# Demo is opt-in. Any other value uses the fail-closed production bootstrap.
APP_MODE=demo

# Production-only server configuration
APP_ORIGIN=https://app.example.com
TELEGRAM_BOT_TOKEN=
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=300
SESSION_SECRET=
OWNER_TELEGRAM_ID=
WORKSPACE_NAME=Smoking Zen

SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ES256 PKCS#8 private key. Escaped \n sequences are supported.
SUPABASE_JWT_ES256_PRIVATE_KEY=
# Must match the kid of the trusted public key imported into Supabase.
SUPABASE_JWT_KID=
