# Режим приложения: demo включается только явно; staging/production используют production.
APP_MODE=production
DEPLOYMENT_ENVIRONMENT=staging
APP_ORIGIN=https://staging.example.com

# Telegram Mini App. Секреты оставляются пустыми и задаются в хранилище окружения.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=smoking_zen_staging_bot
TELEGRAM_MINI_APP_SHORT_NAME=smoking_zen_staging
TELEGRAM_WEBHOOK_SECRET=
INTERNAL_JOB_SECRET=
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=300
SESSION_SECRET=
OWNER_TELEGRAM_ID=
WORKSPACE_NAME=Smoking Zen

# Supabase. Используются отдельные скалярные поля, без составных строк подключения.
SUPABASE_URL=https://abcdefghijklmnopqrst.supabase.co
SUPABASE_SELF_HOSTED_ORIGINS=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_ES256_PRIVATE_KEY=
SUPABASE_JWT_KID=

# Разрешённые корневые адреса self-hosted Bitwarden через запятую; пусто — только bitwarden.com.
BITWARDEN_SELF_HOSTED_ORIGINS=

# Ежедневная резервная копия: PostgreSQL только для чтения и private Storage workspace-files.
BACKUP_PGHOST=db.abcdefghijklmnopqrst.supabase.co
BACKUP_PGPORT=5432
BACKUP_PGDATABASE=postgres
BACKUP_PGUSER=smoking_zen_backup_reader
BACKUP_PGPASSWORD=
BACKUP_PGSSLMODE=verify-full
BACKUP_PGSSLROOTCERT_BASE64=
BACKUP_POSTGRES_MAJOR=17
BACKUP_SOURCE_ENDPOINT=https://abcdefghijklmnopqrst.storage.supabase.co/storage/v1/s3
BACKUP_SOURCE_PROJECT_REF=abcdefghijklmnopqrst
BACKUP_SOURCE_REGION=us-east-1
BACKUP_SOURCE_AUTH_ANON_KEY=
BACKUP_SOURCE_AUTH_EMAIL=
BACKUP_SOURCE_AUTH_PASSWORD=
BACKUP_SOURCE_AUTH_USER_ID=
BACKUP_SOURCE_BUCKET=workspace-files

# Независимое зашифрованное S3-совместимое хранилище; endpoint обязан отличаться от source.
BACKUP_TARGET_ENDPOINT=https://backup.example.com/s3
BACKUP_TARGET_ACCESS_KEY_ID=
BACKUP_TARGET_SECRET_ACCESS_KEY=
BACKUP_TARGET_BUCKET=smoking-zen-backups
BACKUP_TARGET_PREFIX=production/daily
BACKUP_TARGET_ENCRYPTION=AES256
BACKUP_TARGET_KMS_KEY_ID=
BACKUP_TARGET_REGION=us-east-1
BACKUP_TARGET_FORCE_PATH_STYLE=true
BACKUP_DRY_RUN=0

# Отдельные read/list-only credentials freshness используют точные BACKUP_TARGET_* coordinates выше.
BACKUP_FRESHNESS_TARGET_ACCESS_KEY_ID=
BACKUP_FRESHNESS_TARGET_SECRET_ACCESS_KEY=

# Изолированная ежемесячная проверка восстановления.
RESTORE_SNAPSHOT_ID=
RESTORE_TARGET_ENVIRONMENT=restore-drill
RESTORE_DESTRUCTIVE_ACKNOWLEDGEMENT=RESTORE_ISOLATED_TARGET
RESTORE_SOURCE_PROJECT_REF=abcdefghijklmnopqrst
RESTORE_TARGET_PROJECT_REF=zyxwvutsrqponmlkjihg
RESTORE_ARCHIVE_ENDPOINT=https://backup.example.com/s3
RESTORE_ARCHIVE_ACCESS_KEY_ID=
RESTORE_ARCHIVE_SECRET_ACCESS_KEY=
RESTORE_ARCHIVE_BUCKET=smoking-zen-backups
RESTORE_ARCHIVE_PREFIX=production/daily
RESTORE_ARCHIVE_REGION=us-east-1
RESTORE_ARCHIVE_FORCE_PATH_STYLE=true
RESTORE_PGHOST=db.zyxwvutsrqponmlkjihg.supabase.co
RESTORE_PGPORT=5432
RESTORE_PGDATABASE=postgres
RESTORE_PGUSER=postgres
RESTORE_PGPASSWORD=
RESTORE_PGSSLMODE=verify-full
RESTORE_PGSSLROOTCERT_BASE64=
RESTORE_TARGET_ENDPOINT=https://zyxwvutsrqponmlkjihg.storage.supabase.co/storage/v1/s3
RESTORE_TARGET_ACCESS_KEY_ID=
RESTORE_TARGET_SECRET_ACCESS_KEY=
RESTORE_TARGET_BUCKET=workspace-files
RESTORE_TARGET_REGION=us-east-1
RESTORE_TARGET_FORCE_PATH_STYLE=true
